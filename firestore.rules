rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      // Allow reading user profiles so all connected users can see each other on the live map
      allow read: if true;
      // Enforce that users can only create or update their own profile and location
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }
  }
}

