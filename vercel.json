{
  "rewrites": [
    { "source": "/efir", "destination": "/index.html" },
    { "source": "/postlar", "destination": "/index.html" },
    { "source": "/chatroulette", "destination": "/index.html" },
    { "source": "/chatruletka", "destination": "/index.html" },
    { "source": "/((?!assets/|api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://alov.onrender.com https://*.onrender.com https://alov.uz https://www.alov.uz https://web.telegram.org https://*.telegram.org http://localhost:3000 https://*.run.app"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=*, microphone=*, display-capture=*, geolocation=*"
        }
      ]
    }
  ]
}
